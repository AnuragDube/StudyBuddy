# Copy to .env and fill in your keys. NEVER commit the real .env file.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=sqlite:///./study_buddy.db

# --- AI ---
# Primary provider: groq | gemini
AI_PROVIDER=groq
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional baseline / fallback: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Uploads ---
MAX_UPLOAD_MB=10
